{
  "version": 2,
  "framework": null,
  "rewrites": [
    { "source": "/", "destination": "/dashboard.html" },
    { "source": "/memo", "destination": "/docs/submission_memo.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
