{
  "version": 2,
  "framework": null,
  "rewrites": [
    { "source": "/api/v1/detect", "destination": "/api/detect" },
    { "source": "/detect", "destination": "/api/detect" },
    { "source": "/api/v1/reason", "destination": "/api/reason" },
    { "source": "/reason", "destination": "/api/reason" },
    { "source": "/api/v1/health", "destination": "/api/health" },
    { "source": "/health", "destination": "/api/health" },
    { "source": "/", "destination": "/dashboard.html" },
    { "source": "/memo", "destination": "/docs/submission_memo.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "*" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
