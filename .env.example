# Groq API Configuration (Part B Reasoning - Free, 14.4k requests/day)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Part A Object Detection (RT-DETR) Configuration
MODEL_PATH=weights/rtdetr_ppe_best.pt
DEVICE=cpu  # 'cpu', 'cuda', 'cuda:0'

# Unified Confidence Threshold (STRICTLY 0.45 ACROSS ALL LAYERS)
# Used in detection filtering, guardrails, and reasoning
CONFIDENCE_THRESHOLD=0.45
IOU_THRESHOLD=0.50
IMAGE_SIZE=640

# Server Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
